{
  "name": "make10-daily-api",
  "private": true,
  "version": "0.7.0",
  "description": "Make10 デイリーの集計（Cloudflare Workers + D1）。仕様は DAILY-SPEC.md 17 章",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "node test/local_test.mjs",
    "schema:local": "wrangler d1 execute make10-daily --local --file=schema.sql",
    "schema:remote": "wrangler d1 execute make10-daily --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
